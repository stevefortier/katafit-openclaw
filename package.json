  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "peerDependencies": {
    "openclaw": "2026.9.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stevefortier/katafit-openclaw.git"
  },
  "devDependencies": {
    "commander": "15.0.0",
    "zod": "4.6.5"
  }
}
