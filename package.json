{
  "name": "@katafit/openclaw",
  "version": "0.1.0",
  "description": "Kata.fit main Coach background worker for OpenClaw",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "index.js",
    "src",
    "bin",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "bin": {
    "katafit-coach-auth": "bin/auth.js"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
